{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
      },
      {
        "source": "**/*.{png,jpg,jpeg,webp,svg,css,js,pdf}",
        "headers": [{"key":"Cache-Control","value":"public, max-age=3600"}]
      }
    ]
  }
}
